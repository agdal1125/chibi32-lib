# Every frame keeps its bottom row on y 29 so the slime squashes on the ground instead of floating.
[frame base]
slime_mid 8 19

[frame squash]
slime_squash 7 21

[frame stretch]
slime_stretch 9 17

[anim idle]
base 220
squash 140
base 120
stretch 180
