# The cup is drawn after the flame so its outline cuts a clean line under the fire.
[frame base]
handle 15 17
flame_0 12 4
cup 13 14

[frame flick_1]
handle 15 17
flame_1 12 4
cup 13 14

[frame flick_2]
handle 15 17
flame_2 12 4
cup 13 14

[anim burn]
base 120
flick_1 120
flick_2 120
flick_1 120
